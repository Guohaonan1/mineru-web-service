# MinerU 本地服务地址
MINERU_URL=http://localhost:18000
# 可单独指定 v3 地址；未指定时沿用 MINERU_URL
# MINERU_V3_URL=http://localhost:18000
MINERU_V4_URL=http://localhost:18000
# MinerU 4.1.6 Tasks 服务；如需同时运行 4.0，请分别配置两个端口
MINERU_V41_URL=http://localhost:18000
# MinerU CLI，用于网页触发 Standard 模型下载和就绪检查；也可填写实际绝对路径
MINERU_V4_CLI=mineru-kit

# MinIO 对象存储（用于原文件预览）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mineru-files
MINIO_SECURE=false
